<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Department of Transportation Database</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
        }
        header {
            background-color: #333;
            color: #fff;
            padding: 15px 0;
            text-align: center;
        }
        table {
            width: 80%;
            margin: 20px auto;
            border-collapse: collapse;
            background-color: #fff;
        }
        th, td {
            padding: 10px;
            text-align: left;
            border: 1px solid #ddd;
        }
        th {
            background-color: #4CAF50;
            color: white;
        }
        td {
            background-color: #f9f9f9;
        }
        form {
            max-width: 600px;
            margin: 20px auto;
            padding: 20px;
            background-color: #fff;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        input, select, button {
            width: 100%;
            padding: 10px;
            margin: 10px 0;
            border: 1px solid #ddd;
            border-radius: 4px;
        }
        button {
            background-color: #4CAF50;
            color: white;
            cursor: pointer;
        }
        button:hover {
            background-color: #45a049;
        }
        .update-btn, .delete-btn {
            padding: 5px 10px;
            color: white;
            cursor: pointer;
            border-radius: 4px;
        }
        .update-btn {
            background-color: #ffa500;
        }
        .delete-btn {
            background-color: #e74c3c;
        }
        .update-btn:hover {
            background-color: #ff8c00;
        }
        .delete-btn:hover {
            background-color: #c0392b;
        }
    </style>
</head>
<body>

<header>
    <h1>Department of Transportation Database</h1>
</header>

<!-- Add new record form -->
<form id="addForm">
    <h2>Add New Record</h2>
    <label for="vehicle_id">Vehicle ID:</label>
    <input type="text" id="vehicle_id" name="vehicle_id" required>

    <label for="owner_name">Owner Name:</label>
    <input type="text" id="owner_name" name="owner_name" required>

    <label for="vehicle_type">Vehicle Type:</label>
    <select id="vehicle_type" name="vehicle_type" required>
        <option value="Car">Car</option>
        <option value="Bus">Bus</option>
        <option value="ATV">ATV</option>
        <option value="Truck">Truck</option>
    </select>

    <label for="registration_date">Registration Date:</label>
    <input type="date" id="registration_date" name="registration_date" required>

    <label for="status">Status:</label>
    <select id="status" name="status" required>
        <option value="Active">Active</option>
        <option value="Inactive">Inactive</option>
        <option value="Under Maintenance">Under Maintenance</option>
    </select>

    <button type="submit">Add Record</button>
</form>

<!-- Transportation Database Table -->
<table id="transportTable">
    <thead>
        <tr>
            <th>Vehicle ID</th>
            <th>Owner Name</th>
            <th>Vehicle Type</th>
            <th>Registration Date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <!-- Sample record -->
        <tr>
            <td>CAR123</td>
            <td>John Doe</td>
            <td>Car</td>
            <td>2025-02-15</td>
            <td>Active</td>
            <td>
                <button class="update-btn" onclick="editRecord(this)">Update</button>
                <button class="delete-btn" onclick="deleteRecord(this)">Delete</button>
            </td>
        </tr>
        <tr>
            <td>BUS456</td>
            <td>Jane Smith</td>
            <td>Bus</td>
            <td>2024-11-05</td>
            <td>Under Maintenance</td>
            <td>
                <button class="update-btn" onclick="editRecord(this)">Update</button>
                <button class="delete-btn" onclick="deleteRecord(this)">Delete</button>
            </td>
        </tr>
        <tr>
            <td>ATV789</td>
            <td>Mark Lee</td>
            <td>ATV</td>
            <td>2024-12-25</td>
            <td>Active</td>
            <td>
                <button class="update-btn" onclick="editRecord(this)">Update</button>
                <button class="delete-btn" onclick="deleteRecord(this)">Delete</button>
            </td>
        </tr>
        <tr>
            <td>TRK101</td>
            <td>Susan Wong</td>
            <td>Truck</td>
            <td>2023-09-10</td>
            <td>Inactive</td>
            <td>
                <button class="update-btn" onclick="editRecord(this)">Update</button>
                <button class="delete-btn" onclick="deleteRecord(this)">Delete</button>
            </td>
        </tr>
    </tbody>
</table>

<script>
    // Handle adding new records
    document.getElementById('addForm').addEventListener('submit', function(event) {
        event.preventDefault();
        
        // Get form data
        const vehicleId = document.getElementById('vehicle_id').value;
        const ownerName = document.getElementById('owner_name').value;
        const vehicleType = document.getElementById('vehicle_type').value;
        const registrationDate = document.getElementById('registration_date').value;
        const status = document.getElementById('status').value;

        // Create a new table row with the data
        const table = document.getElementById('transportTable').getElementsByTagName('tbody')[0];
        const newRow = table.insertRow();

        newRow.innerHTML = 
            <td>${vehicleId}</td>
            <td>${ownerName}</td>
            <td>${vehicleType}</td>
            <td>${registrationDate}</td>
            <td>${status}</td>
            <td>
                <button class="update-btn" onclick="editRecord(this)">Update</button>
                <button class="delete-btn" onclick="deleteRecord(this)">Delete</button>
            </td>
        ;

        // Reset the form fields
        document.getElementById('addForm').reset();
    });

    // Edit record function
    function editRecord(button) {
        const row = button.closest('tr');
        const cells = row.getElementsByTagName('td');
        
        // Pre-fill the form with the current record's data
        document.getElementById('vehicle_id').value = cells[0].textContent;
        document.getElementById('owner_name').value = cells[1].textContent;
        document.getElementById('vehicle_type').value = cells[2].textContent;
        document.getElementById('registration_date').value = cells[3].textContent;
        document.getElementById('status').value = cells[4].textContent;

        // Remove the row for now
        row.remove();
    }

    // Delete record function
    function deleteRecord(button) {
        const row = button.closest('tr');
        row.remove();
    }
</script>

</body>
</html>
